# ==============================================================================
# API SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE APPROPRIATE VALUES FOR YOUR ENVIRONMENT.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# ENVIRONMENT: Options: 'development', 'staging', 'production'
ENVIRONMENT=development

# DEBUG: Set to False in production to disable verbose tracebacks
DEBUG=True

# Host and Port binding for the FastAPI ASGI server
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS (CROSS-ORIGIN RESOURCE SHARING) WHITELIST
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins. Never use '*' in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite default for standalone / local lab use:
DATABASE_URL=sqlite:///./api_sentinel.db
# For production PostgreSQL deployments (example):
# DATABASE_URL=postgresql://sentinel_user:your_secure_password@localhost:5432/api_sentinel_db

# ------------------------------------------------------------------------------
# 4. SAFETY & SSRF LAB CONTROLS
# ------------------------------------------------------------------------------
# ALLOW_LOCAL_LAB_SCANNING:
# Set to 'True' ONLY in controlled educational lab/demo environments to permit
# loopback / private IP scanning (e.g. scanning Healthcare Demo API on 127.0.0.1).
# MUST be set to 'False' in production deployments to strictly block all private
# RFC1918 subnets and cloud metadata endpoints (169.254.169.254).
ALLOW_LOCAL_LAB_SCANNING=True

# ------------------------------------------------------------------------------
# 5. CREDENTIAL VAULT AUTHENTICATED ENCRYPTION (REQUIRED FOR TARGET CREDENTIALS)
# ------------------------------------------------------------------------------
# A 32-byte URL-safe base64-encoded Fernet encryption key used to encrypt
# target API credentials at rest in the database (AES-128-CBC + HMAC-SHA256).
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TARGET_CREDENTIAL_ENCRYPTION_KEY=YOUR_BASE64_32BYTE_FERNET_KEY_HERE

# ------------------------------------------------------------------------------
# 6. NVIDIA NEMOTRON AI INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# If left empty, API Sentinel seamlessly uses its built-in deterministic rule-based
# fallback engine with zero external network dependencies.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_TIMEOUT_SECONDS=30
